# Copy to .env (never commit it). Real environment variables win over this file.
# The runtime reads this file first, then starter-kit/.env.
ARENA_URL=https://arena.tacto.ai
# Our team's key from https://arena.tacto.ai/apply (one per team; never commit it)
ARENA_API_KEY=
# The data package (relative to this file)
ARENA_DATA=data

# LLM (the Diplomat's client reads these)
LLM_PROVIDER=anthropic
LLM_MODEL=claude-opus-5-5
LLM_EFFORT=low
ANTHROPIC_API_KEY=
